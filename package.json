{
  "name": "hubspot-mcp-wrap",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A client's own OAuth front door to HubSpot's remote MCP server, so Codex and any MCP client (not only Claude) can connect, each person as themselves.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env example",
    "deploy": "wrangler deploy --env",
    "types": "wrangler types --env example",
    "check": "wrangler types --env example && tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
